{
  "name": "notebook-nextjs-template",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "build:demo": "NEXT_PUBLIC_SITE_URL=https://freeframe.dev DEMO_BASE_PATH=/demos/nextjs/notebook next build && rm -rf demo && mv out demo"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
